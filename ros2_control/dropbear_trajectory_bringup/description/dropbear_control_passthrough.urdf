<?xml version="1.0"?>
<!--
  Controller-interface description only. The browser renders the tracked
  dropbear.usd; this deliberately does not claim to be a canonical URDF
  conversion of its closed-loop mechanism.
-->
<robot name="dropbear_control_passthrough">
