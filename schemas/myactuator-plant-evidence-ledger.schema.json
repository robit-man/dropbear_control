{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hyperspawn.dev/schemas/myactuator-plant-evidence-ledger.schema.json",
  "title": "Model-complete MYACTUATOR plant evidence ledger",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "artifact_id",
    "authority",
    "sources",
    "policy",
    "parameter_catalog",
    "operating_envelope_catalog",
    "candidate_product_manuals",
    "source_facts",
    "models",
    "summary",
    "support_granted",
    "physical_motion_authority",
    "integrity"
  ],
  "properties": {
    "schema_version": {
      "const": "myactuator-plant-evidence-ledger/1"
    },
    "artifact_id": {
      "const": "myactuator-plant-evidence-ledger"
    },
    "authority": {
      "const": "source_navigation_missing_evidence_and_admission_denial_only"
    },
    "sources": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "catalog_sha256",
        "protocol_applicability_registry_sha256",
        "plant_runtime_registry_sha256",
        "plant_spec_candidate_registry_sha256",
        "plant_candidate_decision_registry_sha256",
        "source_fact_schema_sha256",
        "source_fact_file_sha256"
      ],
      "properties": {
        "catalog_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "protocol_applicability_registry_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "plant_runtime_registry_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "plant_spec_candidate_registry_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "plant_candidate_decision_registry_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "source_fact_schema_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "source_fact_file_sha256": {
          "type": "object",
          "propertyNames": {
            "pattern": "^plantfact-[0-9a-f]{20}$"
          },
          "additionalProperties": {
            "$ref": "#/$defs/sha256"
          }
        }
      }
    },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "all_catalog_models_required",
        "missing_is_null_and_blocking",
        "family_default_forbidden",
        "silent_unit_conversion_forbidden",
        "source_hash_page_and_locator_required",
        "generated_extraction_cannot_accept",
        "candidate_lifecycle_materialization_required",
        "independent_review_required",
        "uncertainty_classes_non_substitutable",
        "source_fit_correlation_states_separate",
        "operating_envelope_required",
        "synthetic_evidence_never_fills_real_model",
        "runtime_plant_requires_qualified_parameter_set",
        "ledger_never_grants_motor_support"
      ],
      "properties": {
        "all_catalog_models_required": {
          "const": true
        },
        "missing_is_null_and_blocking": {
          "const": true
        },
        "family_default_forbidden": {
          "const": true
        },
        "silent_unit_conversion_forbidden": {
          "const": true
        },
        "source_hash_page_and_locator_required": {
          "const": true
        },
        "generated_extraction_cannot_accept": {
          "const": true
        },
        "candidate_lifecycle_materialization_required": {
          "const": true
        },
        "independent_review_required": {
          "const": true
        },
        "uncertainty_classes_non_substitutable": {
          "const": true
        },
        "source_fit_correlation_states_separate": {
          "const": true
        },
        "operating_envelope_required": {
          "const": true
        },
        "synthetic_evidence_never_fills_real_model": {
          "const": true
        },
        "runtime_plant_requires_qualified_parameter_set": {
          "const": true
        },
        "ledger_never_grants_motor_support": {
          "const": true
        }
      }
    },
    "parameter_catalog": {
      "type": "array",
      "minItems": 34,
      "maxItems": 34,
      "items": {
        "$ref": "#/$defs/requirementDefinition"
      }
    },
    "operating_envelope_catalog": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": {
        "$ref": "#/$defs/requirementDefinition"
      }
    },
    "candidate_product_manuals": {
      "type": "array",
      "minItems": 15,
      "maxItems": 15,
      "items": {
        "$ref": "#/$defs/manual"
      }
    },
    "source_facts": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "models": {
      "type": "array",
      "minItems": 44,
      "maxItems": 44,
      "items": {
        "$ref": "#/$defs/model"
      }
    },
    "summary": {
      "$ref": "#/$defs/summary"
    },
    "support_granted": {
      "const": false
    },
    "physical_motion_authority": {
      "const": false
    },
    "integrity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "record_sha256"
      ],
      "properties": {
        "record_sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "idText": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*$"
    },
    "requirementDefinition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "requirement_kind",
        "field_id",
        "domain",
        "name",
        "canonical_unit",
        "model_form"
      ],
      "properties": {
        "requirement_kind": {
          "enum": [
            "parameter",
            "operating_envelope"
          ]
        },
        "field_id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*\\.[a-z][a-z0-9_]*$"
        },
        "domain": {
          "$ref": "#/$defs/idText"
        },
        "name": {
          "$ref": "#/$defs/idText"
        },
        "canonical_unit": {
          "type": "string",
          "minLength": 1
        },
        "model_form": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "manual": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "document_occurrence_id",
        "package_id",
        "series",
        "document_set",
        "file_name",
        "vendor_relative_path",
        "file_sha256",
        "bytes",
        "candidate_only"
      ],
      "properties": {
        "document_occurrence_id": {
          "type": "string",
          "pattern": "^dococc-[0-9a-f]{20}$"
        },
        "package_id": {
          "type": "string",
          "pattern": "^docpkg-[0-9a-f]{20}$"
        },
        "series": {
          "type": "string",
          "minLength": 1
        },
        "document_set": {
          "type": "string",
          "minLength": 1
        },
        "file_name": {
          "type": "string",
          "minLength": 1
        },
        "vendor_relative_path": {
          "type": "string",
          "minLength": 1
        },
        "file_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "bytes": {
          "type": "integer",
          "minimum": 1
        },
        "candidate_only": {
          "const": true
        }
      }
    },
    "requirementState": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "field_id",
        "expected_unit",
        "status",
        "candidate_fact_ids",
        "selected_fact_id",
        "value",
        "uncertainty",
        "blockers"
      ],
      "properties": {
        "field_id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*\\.[a-z][a-z0-9_]*$"
        },
        "expected_unit": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "enum": [
            "missing",
            "candidate_unreviewed",
            "accepted_source_fact"
          ]
        },
        "candidate_fact_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^plantfact-[0-9a-f]{20}$"
          }
        },
        "selected_fact_id": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^plantfact-[0-9a-f]{20}$"
        },
        "value": {
          "oneOf": [
            {
              "type": "number"
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "minimum",
                "maximum"
              ],
              "properties": {
                "minimum": {
                  "type": "number"
                },
                "maximum": {
                  "type": "number"
                }
              }
            },
            {
              "type": "null"
            }
          ]
        },
        "uncertainty": {
          "oneOf": [
            {
              "type": "object"
            },
            {
              "type": "null"
            }
          ]
        },
        "blockers": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/idText"
          }
        }
      }
    },
    "model": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "model_key",
        "series",
        "model",
        "package_revision",
        "candidate_product_manual_occurrence_ids",
        "source_fact_ids",
        "parameter_evidence",
        "operating_envelope_evidence",
        "source_fact_complete",
        "correlation_complete",
        "runtime_plant_ids",
        "plant_status",
        "blockers",
        "support_granted"
      ],
      "properties": {
        "model_key": {
          "type": "string",
          "pattern": "^model-[0-9a-f]{20}$"
        },
        "series": {
          "type": "string",
          "minLength": 1
        },
        "model": {
          "type": "string",
          "minLength": 1
        },
        "package_revision": {
          "type": "string",
          "minLength": 1
        },
        "candidate_product_manual_occurrence_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^dococc-[0-9a-f]{20}$"
          }
        },
        "source_fact_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^plantfact-[0-9a-f]{20}$"
          }
        },
        "parameter_evidence": {
          "type": "array",
          "minItems": 34,
          "maxItems": 34,
          "items": {
            "$ref": "#/$defs/requirementState"
          }
        },
        "operating_envelope_evidence": {
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "items": {
            "$ref": "#/$defs/requirementState"
          }
        },
        "source_fact_complete": {
          "type": "boolean"
        },
        "correlation_complete": {
          "type": "boolean"
        },
        "runtime_plant_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^plant-[a-z0-9][a-z0-9-]*$"
          }
        },
        "plant_status": {
          "enum": [
            "unsupported",
            "sourced",
            "partially_validated",
            "validated"
          ]
        },
        "blockers": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/idText"
          }
        },
        "support_granted": {
          "const": false
        }
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "model_count",
        "parameter_domain_count",
        "required_parameter_field_count",
        "model_parameter_requirement_count",
        "required_operating_envelope_field_count",
        "model_operating_envelope_requirement_count",
        "candidate_product_manual_occurrence_count",
        "candidate_model_manual_relationship_count",
        "source_fact_count",
        "unreviewed_source_fact_count",
        "accepted_source_fact_count",
        "missing_parameter_requirement_count",
        "missing_operating_envelope_requirement_count",
        "source_fact_complete_model_count",
        "correlated_model_count",
        "runtime_plant_count",
        "supported_model_count"
      ],
      "properties": {
        "model_count": {
          "const": 44
        },
        "parameter_domain_count": {
          "const": 7
        },
        "required_parameter_field_count": {
          "const": 34
        },
        "model_parameter_requirement_count": {
          "const": 1496
        },
        "required_operating_envelope_field_count": {
          "const": 4
        },
        "model_operating_envelope_requirement_count": {
          "const": 176
        },
        "candidate_product_manual_occurrence_count": {
          "const": 15
        },
        "candidate_model_manual_relationship_count": {
          "type": "integer",
          "minimum": 44
        },
        "source_fact_count": {
          "type": "integer",
          "minimum": 0
        },
        "unreviewed_source_fact_count": {
          "type": "integer",
          "minimum": 0
        },
        "accepted_source_fact_count": {
          "type": "integer",
          "minimum": 0
        },
        "missing_parameter_requirement_count": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1496
        },
        "missing_operating_envelope_requirement_count": {
          "type": "integer",
          "minimum": 0,
          "maximum": 176
        },
        "source_fact_complete_model_count": {
          "type": "integer",
          "minimum": 0,
          "maximum": 44
        },
        "correlated_model_count": {
          "type": "integer",
          "minimum": 0,
          "maximum": 44
        },
        "runtime_plant_count": {
          "type": "integer",
          "minimum": 0
        },
        "supported_model_count": {
          "const": 0
        }
      }
    }
  }
}
