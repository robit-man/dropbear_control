{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hyperspawn.dev/schemas/myactuator-evidence-intake-packet.schema.json",
  "title": "Generated MYACTUATOR human evidence intake packet",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "record_state",
    "packet_id",
    "packet_kind",
    "authority",
    "queue_binding",
    "subject",
    "workflow",
    "source_bindings",
    "tasks",
    "blocker_ids",
    "accepted",
    "support_granted",
    "physical_motion_authority",
    "physical_action_permitted",
    "integrity"
  ],
  "properties": {
    "schema_version": {
      "const": "myactuator-evidence-intake-packet/1"
    },
    "record_state": {
      "const": "generated_draft"
    },
    "packet_id": {
      "type": "string",
      "pattern": "^intakepacket-[0-9a-f]{20}$"
    },
    "packet_kind": {
      "enum": [
        "cad_semantic_review",
        "plant_source_extraction"
      ]
    },
    "authority": {
      "const": "handoff_navigation_and_draft_scaffolding_only"
    },
    "queue_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "queue_id",
        "queue_sha256",
        "item_id"
      ],
      "properties": {
        "queue_id": {
          "type": "string",
          "pattern": "^reviewqueue-[0-9a-f]{20}$"
        },
        "queue_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "item_id": {
          "type": "string",
          "pattern": "^reviewitem-[0-9a-f]{20}$"
        }
      }
    },
    "subject": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "subject_id",
        "series",
        "model",
        "package_revision",
        "configuration_id",
        "variant_id"
      ],
      "properties": {
        "subject_id": {
          "$ref": "#/$defs/exact"
        },
        "series": {
          "$ref": "#/$defs/exact"
        },
        "model": {
          "$ref": "#/$defs/exact"
        },
        "package_revision": {
          "oneOf": [
            {
              "$ref": "#/$defs/exact"
            },
            {
              "type": "null"
            }
          ]
        },
        "configuration_id": {
          "oneOf": [
            {
              "type": "string",
              "pattern": "^cadcfg-[0-9a-f]{20}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "variant_id": {
          "oneOf": [
            {
              "type": "string",
              "pattern": "^step-[0-9a-f]{20}$"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "workflow": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "readiness",
        "assignment_role_ids",
        "assigned",
        "next_action",
        "output_schema",
        "controlled_output_directory",
        "submission_preconditions"
      ],
      "properties": {
        "readiness": {
          "enum": [
            "ready_for_review",
            "source_or_partition_needed",
            "ready_for_extraction"
          ]
        },
        "assignment_role_ids": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/exact"
          }
        },
        "assigned": {
          "type": "boolean"
        },
        "next_action": {
          "$ref": "#/$defs/exact"
        },
        "output_schema": {
          "$ref": "#/$defs/path"
        },
        "controlled_output_directory": {
          "$ref": "#/$defs/path"
        },
        "submission_preconditions": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/exact"
          }
        }
      }
    },
    "source_bindings": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/sourceBinding"
      }
    },
    "tasks": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/task"
      }
    },
    "blocker_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/exact"
      }
    },
    "accepted": {
      "const": false
    },
    "support_granted": {
      "const": false
    },
    "physical_motion_authority": {
      "const": false
    },
    "physical_action_permitted": {
      "const": false
    },
    "integrity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "record_sha256"
      ],
      "properties": {
        "record_sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "exact": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2048,
      "pattern": "^[^\\r\\n\\t]+$"
    },
    "path": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2048,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[^\\r\\n\\t]+$"
    },
    "sourceBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "binding_id",
        "source_kind",
        "occurrence_id",
        "local_path",
        "sha256",
        "candidate_only",
        "redistribution_authority"
      ],
      "properties": {
        "binding_id": {
          "type": "string",
          "pattern": "^intakesource-[0-9a-f]{20}$"
        },
        "source_kind": {
          "enum": [
            "vendor_step",
            "vendor_pdf",
            "review_packet",
            "review_image",
            "candidate_export",
            "plant_spec_candidate_registry"
          ]
        },
        "occurrence_id": {
          "$ref": "#/$defs/exact"
        },
        "local_path": {
          "$ref": "#/$defs/path"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "candidate_only": {
          "const": true
        },
        "redistribution_authority": {
          "const": false
        }
      }
    },
    "task": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "task_id",
        "task_kind",
        "prompt",
        "current_state",
        "canonical_unit",
        "candidate_source_ids",
        "required_evidence_class",
        "candidate_evidence_refs",
        "response",
        "response_evidence_refs"
      ],
      "properties": {
        "task_id": {
          "$ref": "#/$defs/exact"
        },
        "task_kind": {
          "enum": [
            "cad_question",
            "plant_parameter",
            "plant_operating_envelope"
          ]
        },
        "prompt": {
          "$ref": "#/$defs/exact"
        },
        "current_state": {
          "enum": [
            "unanswered",
            "missing"
          ]
        },
        "canonical_unit": {
          "oneOf": [
            {
              "$ref": "#/$defs/exact"
            },
            {
              "type": "null"
            }
          ]
        },
        "candidate_source_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^intakesource-[0-9a-f]{20}$"
          }
        },
        "required_evidence_class": {
          "$ref": "#/$defs/exact"
        },
        "candidate_evidence_refs": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^plantspeccandidate-[0-9a-f]{20}$"
          }
        },
        "response": {
          "type": "null"
        },
        "response_evidence_refs": {
          "type": "array",
          "maxItems": 0
        }
      }
    }
  }
}
