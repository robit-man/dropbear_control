{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hyperspawn.dev/schemas/myactuator-plant-runtime-profile.schema.json",
  "title": "Reviewed MYACTUATOR sourced-plant execution profile",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "profile_id",
    "record_state",
    "subject",
    "execution",
    "review",
    "authority",
    "integrity"
  ],
  "properties": {
    "schema_version": {
      "const": "myactuator-plant-runtime-profile/1"
    },
    "profile_id": {
      "type": "string",
      "pattern": "^plantprofile-[0-9a-f]{20}$"
    },
    "record_state": {
      "const": "submitted"
    },
    "subject": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "plant_id",
        "parameter_set_sha256",
        "assembly_registry_generation_sha256",
        "adapter_id",
        "applicability"
      ],
      "properties": {
        "plant_id": {
          "type": "string",
          "pattern": "^plant-[a-z0-9][a-z0-9-]*$"
        },
        "parameter_set_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "assembly_registry_generation_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "adapter_id": {
          "const": "plant-adapter-deterministic-fixed-step-v1"
        },
        "applicability": {
          "$ref": "#/$defs/applicability"
        }
      }
    },
    "execution": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "torque_regime",
        "supply_voltage_v",
        "ambient_temperature_k",
        "rotation_direction",
        "position_lower_rad",
        "position_upper_rad",
        "output_load_torque_bound_nm",
        "transmission_damping_nm_s_per_rad",
        "current_controller_kp_v_per_a",
        "derate_start_temperature_k"
      ],
      "properties": {
        "torque_regime": {
          "const": "continuous_only"
        },
        "supply_voltage_v": {
          "type": "number"
        },
        "ambient_temperature_k": {
          "type": "number"
        },
        "rotation_direction": {
          "enum": [
            "positive",
            "negative",
            "bidirectional"
          ]
        },
        "position_lower_rad": {
          "type": "number"
        },
        "position_upper_rad": {
          "type": "number"
        },
        "output_load_torque_bound_nm": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "transmission_damping_nm_s_per_rad": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "current_controller_kp_v_per_a": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "derate_start_temperature_k": {
          "type": "number",
          "exclusiveMinimum": 0
        }
      }
    },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "prepared_by",
        "reviewed_by",
        "reviewed_at_utc",
        "rationale"
      ],
      "properties": {
        "status": {
          "const": "accepted"
        },
        "prepared_by": {
          "$ref": "#/$defs/preparer"
        },
        "reviewed_by": {
          "$ref": "#/$defs/reviewer"
        },
        "reviewed_at_utc": {
          "type": "string",
          "format": "date-time"
        },
        "rationale": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "support_granted",
        "physical_motion_authority",
        "physical_validation_claimed"
      ],
      "properties": {
        "support_granted": {
          "const": false
        },
        "physical_motion_authority": {
          "const": false
        },
        "physical_validation_claimed": {
          "const": false
        }
      }
    },
    "integrity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "record_sha256"
      ],
      "properties": {
        "record_sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "exactText": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!.*[?*\\[\\]{}]).+$"
    },
    "actor": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "actor_id",
        "actor_type",
        "role"
      ],
      "properties": {
        "actor_id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]{2,127}$"
        },
        "actor_type": {
          "const": "human"
        },
        "role": {
          "enum": [
            "simulation_engineer",
            "controls_safety_reviewer"
          ]
        }
      }
    },
    "preparer": {
      "allOf": [
        {
          "$ref": "#/$defs/actor"
        },
        {
          "properties": {
            "role": {
              "const": "simulation_engineer"
            }
          }
        }
      ]
    },
    "reviewer": {
      "allOf": [
        {
          "$ref": "#/$defs/actor"
        },
        {
          "properties": {
            "role": {
              "const": "controls_safety_reviewer"
            }
          }
        }
      ]
    },
    "applicability": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "series",
        "model",
        "hardware_revision",
        "drive_firmware",
        "protocol_version",
        "transport",
        "control_mode"
      ],
      "properties": {
        "series": {
          "$ref": "#/$defs/exactText"
        },
        "model": {
          "$ref": "#/$defs/exactText"
        },
        "hardware_revision": {
          "$ref": "#/$defs/exactText"
        },
        "drive_firmware": {
          "$ref": "#/$defs/exactText"
        },
        "protocol_version": {
          "$ref": "#/$defs/exactText"
        },
        "transport": {
          "$ref": "#/$defs/exactText"
        },
        "control_mode": {
          "$ref": "#/$defs/exactText"
        }
      }
    }
  }
}
