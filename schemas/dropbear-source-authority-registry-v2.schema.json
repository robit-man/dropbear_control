{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hyperspawn.org/schemas/dropbear-source-authority-registry-v2.schema.json",
  "title": "Dropbear source-authority lifecycle registry V2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "artifact_id",
    "authority",
    "source",
    "registry_generation_sha256",
    "submissions",
    "events",
    "active_submission_id",
    "active_decision_id",
    "active_decision_sha256",
    "summary",
    "blockers",
    "support_granted",
    "physical_motion_authority",
    "integrity"
  ],
  "properties": {
    "schema_version": { "const": "dropbear-source-authority-registry/2" },
    "artifact_id": { "const": "dropbear-source-authority-registry-v2" },
    "authority": { "const": "source_selection_only" },
    "source": { "$ref": "#/$defs/source" },
    "registry_generation_sha256": { "$ref": "#/$defs/sha256" },
    "submissions": {
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/submissionEntry" }
    },
    "events": {
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/eventEntry" }
    },
    "active_submission_id": {
      "type": ["string", "null"],
      "pattern": "^sourcesubmission-[0-9a-f]{20}$"
    },
    "active_decision_id": {
      "type": ["string", "null"],
      "pattern": "^sourceauthority-[0-9a-f]{20}$"
    },
    "active_decision_sha256": {
      "anyOf": [{ "$ref": "#/$defs/sha256" }, { "type": "null" }]
    },
    "summary": { "$ref": "#/$defs/summary" },
    "blockers": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "support_granted": { "const": false },
    "physical_motion_authority": { "const": false },
    "integrity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["record_sha256"],
      "properties": {
        "record_sha256": { "$ref": "#/$defs/sha256" }
      }
    }
  },
  "$defs": {
    "text": { "type": "string", "minLength": 1 },
    "sha1": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "inventory_path",
        "inventory_sha256",
        "repository_commit",
        "repository_tree_id",
        "canonical_configuration_digest",
        "v1_status_path",
        "v1_status_sha256"
      ],
      "properties": {
        "inventory_path": {
          "const": "generated/dropbear_description/inventory.json"
        },
        "inventory_sha256": { "$ref": "#/$defs/sha256" },
        "repository_commit": { "$ref": "#/$defs/sha1" },
        "repository_tree_id": { "$ref": "#/$defs/sha1" },
        "canonical_configuration_digest": { "$ref": "#/$defs/sha256" },
        "v1_status_path": {
          "const": "generated/dropbear_source_authority/status.json"
        },
        "v1_status_sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "submissionEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "submission_id",
        "submission_path",
        "submission_sha256",
        "decision_id",
        "decision_sha256",
        "lifecycle_state",
        "runtime_description_complete",
        "superseded_by_submission_id",
        "last_event_id"
      ],
      "properties": {
        "submission_id": {
          "type": "string",
          "pattern": "^sourcesubmission-[0-9a-f]{20}$"
        },
        "submission_path": { "$ref": "#/$defs/text" },
        "submission_sha256": { "$ref": "#/$defs/sha256" },
        "decision_id": {
          "type": "string",
          "pattern": "^sourceauthority-[0-9a-f]{20}$"
        },
        "decision_sha256": { "$ref": "#/$defs/sha256" },
        "lifecycle_state": {
          "enum": ["submitted", "accepted", "rejected", "revoked", "superseded"]
        },
        "runtime_description_complete": { "type": "boolean" },
        "superseded_by_submission_id": {
          "type": ["string", "null"],
          "pattern": "^sourcesubmission-[0-9a-f]{20}$"
        },
        "last_event_id": {
          "type": ["string", "null"],
          "pattern": "^sourceevent-[0-9a-f]{20}$"
        }
      }
    },
    "eventEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sequence",
        "event_id",
        "event_path",
        "event_sha256",
        "event_type"
      ],
      "properties": {
        "sequence": { "type": "integer", "minimum": 1 },
        "event_id": {
          "type": "string",
          "pattern": "^sourceevent-[0-9a-f]{20}$"
        },
        "event_path": { "$ref": "#/$defs/text" },
        "event_sha256": { "$ref": "#/$defs/sha256" },
        "event_type": { "enum": ["accept", "reject", "revoke", "supersede"] }
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "submission_count",
        "event_count",
        "submitted_count",
        "accepted_count",
        "rejected_count",
        "revoked_count",
        "superseded_count",
        "active_runtime_complete_count",
        "source_authority_selected"
      ],
      "properties": {
        "submission_count": { "type": "integer", "minimum": 0 },
        "event_count": { "type": "integer", "minimum": 0 },
        "submitted_count": { "type": "integer", "minimum": 0 },
        "accepted_count": { "type": "integer", "minimum": 0, "maximum": 1 },
        "rejected_count": { "type": "integer", "minimum": 0 },
        "revoked_count": { "type": "integer", "minimum": 0 },
        "superseded_count": { "type": "integer", "minimum": 0 },
        "active_runtime_complete_count": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1
        },
        "source_authority_selected": { "type": "boolean" }
      }
    }
  }
}
