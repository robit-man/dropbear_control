{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hyperspawn.dev/schemas/myactuator-plant-candidate-submission.schema.json",
  "title": "MYACTUATOR plant specification candidate review submission",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "submission_id",
    "submitted_at_utc",
    "supersedes_submission_id",
    "subject",
    "extractor",
    "proposal",
    "evidence_refs",
    "support_granted",
    "physical_motion_authority",
    "integrity"
  ],
  "properties": {
    "schema_version": {
      "const": "myactuator-plant-candidate-submission/1"
    },
    "submission_id": {
      "type": "string",
      "pattern": "^plantcandidatesubmission-[0-9a-f]{20}$"
    },
    "submitted_at_utc": {
      "type": "string",
      "format": "date-time"
    },
    "supersedes_submission_id": {
      "type": ["string", "null"],
      "pattern": "^plantcandidatesubmission-[0-9a-f]{20}$"
    },
    "subject": {
      "$ref": "#/$defs/subject"
    },
    "extractor": {
      "$ref": "#/$defs/extractor"
    },
    "proposal": {
      "$ref": "#/$defs/proposal"
    },
    "evidence_refs": {
      "$ref": "#/$defs/refs"
    },
    "support_granted": {
      "const": false
    },
    "physical_motion_authority": {
      "const": false
    },
    "integrity": {
      "$ref": "#/$defs/integrity"
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "text": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2048,
      "pattern": "^[^\\r\\n\\t]+$"
    },
    "nullableText": {
      "oneOf": [
        {"$ref": "#/$defs/text"},
        {"type": "null"}
      ]
    },
    "refs": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/text"
      }
    },
    "subject": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "candidate_registry_sha256",
        "candidate_id",
        "candidate_sha256",
        "table_id",
        "model_key"
      ],
      "properties": {
        "candidate_registry_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "candidate_id": {
          "type": "string",
          "pattern": "^plantspeccandidate-[0-9a-f]{20}$"
        },
        "candidate_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "table_id": {
          "type": "string",
          "pattern": "^plantspectable-[0-9a-f]{20}$"
        },
        "model_key": {
          "type": "string",
          "pattern": "^model-[0-9a-f]{20}$"
        }
      }
    },
    "extractor": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "role_id",
        "actor_id",
        "organization_or_team",
        "human_attested",
        "assignment_register_revision",
        "competence_evidence_refs",
        "extraction_assertion"
      ],
      "properties": {
        "role_id": {
          "const": "plant_source_extractor"
        },
        "actor_id": {
          "$ref": "#/$defs/text"
        },
        "organization_or_team": {
          "$ref": "#/$defs/text"
        },
        "human_attested": {
          "const": true
        },
        "assignment_register_revision": {
          "type": "integer",
          "minimum": 1
        },
        "competence_evidence_refs": {
          "$ref": "#/$defs/refs"
        },
        "extraction_assertion": {
          "$ref": "#/$defs/text"
        }
      }
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "requirement_kind",
        "domain",
        "name",
        "canonical_unit"
      ],
      "properties": {
        "requirement_kind": {
          "enum": ["parameter", "operating_envelope"]
        },
        "domain": {
          "enum": [
            "electrical",
            "mechanical",
            "transmission",
            "saturation",
            "thermal",
            "sensor",
            "latency",
            "operating_envelope"
          ]
        },
        "name": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$"
        },
        "canonical_unit": {
          "$ref": "#/$defs/text"
        }
      }
    },
    "conversion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "scale", "offset", "expression"],
      "properties": {
        "kind": {
          "enum": ["identity", "exact_linear_si", "reviewed_derivation"]
        },
        "scale": {
          "type": "number"
        },
        "offset": {
          "type": "number"
        },
        "expression": {
          "$ref": "#/$defs/nullableText"
        }
      }
    },
    "scalarObservation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "shape",
        "source_value",
        "source_unit",
        "normalized_value",
        "normalized_unit",
        "conversion"
      ],
      "properties": {
        "shape": {
          "const": "scalar"
        },
        "source_value": {
          "type": "number"
        },
        "source_unit": {
          "$ref": "#/$defs/text"
        },
        "normalized_value": {
          "type": "number"
        },
        "normalized_unit": {
          "$ref": "#/$defs/text"
        },
        "conversion": {
          "$ref": "#/$defs/conversion"
        }
      }
    },
    "rangeObservation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "shape",
        "source_minimum",
        "source_maximum",
        "source_unit",
        "normalized_minimum",
        "normalized_maximum",
        "normalized_unit",
        "conversion"
      ],
      "properties": {
        "shape": {
          "const": "range"
        },
        "source_minimum": {
          "type": "number"
        },
        "source_maximum": {
          "type": "number"
        },
        "source_unit": {
          "$ref": "#/$defs/text"
        },
        "normalized_minimum": {
          "type": "number"
        },
        "normalized_maximum": {
          "type": "number"
        },
        "normalized_unit": {
          "$ref": "#/$defs/text"
        },
        "conversion": {
          "$ref": "#/$defs/conversion"
        }
      }
    },
    "observation": {
      "oneOf": [
        {"$ref": "#/$defs/scalarObservation"},
        {"$ref": "#/$defs/rangeObservation"},
        {"type": "null"}
      ]
    },
    "uncertainty": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "class",
        "lower",
        "upper",
        "unit",
        "coverage_probability"
      ],
      "properties": {
        "class": {
          "enum": [
            "source_stated_bound",
            "transcribed_display_resolution",
            "digitization_bound",
            "derived_bound"
          ]
        },
        "lower": {
          "type": "number"
        },
        "upper": {
          "type": "number"
        },
        "unit": {
          "$ref": "#/$defs/text"
        },
        "coverage_probability": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 1
        }
      }
    },
    "operatingCondition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "supply_voltage_v",
        "ambient_temperature_k",
        "rotation_direction",
        "notes"
      ],
      "properties": {
        "supply_voltage_v": {
          "type": ["number", "null"]
        },
        "ambient_temperature_k": {
          "type": ["number", "null"]
        },
        "rotation_direction": {
          "enum": [
            "positive",
            "negative",
            "bidirectional",
            "not_stated"
          ]
        },
        "notes": {
          "$ref": "#/$defs/nullableText"
        }
      }
    },
    "sourceInterpretation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "selected_number_indices",
        "qualifier_resolution",
        "annotation_resolution",
        "alternative_resolution"
      ],
      "properties": {
        "selected_number_indices": {
          "type": "array",
          "minItems": 1,
          "maxItems": 2,
          "uniqueItems": true,
          "items": {
            "type": "integer",
            "minimum": 0
          }
        },
        "qualifier_resolution": {
          "$ref": "#/$defs/nullableText"
        },
        "annotation_resolution": {
          "$ref": "#/$defs/nullableText"
        },
        "alternative_resolution": {
          "$ref": "#/$defs/nullableText"
        }
      }
    },
    "factProposal": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mapping_action",
        "target",
        "observation",
        "source_interpretation",
        "evidence_class",
        "extraction_method",
        "uncertainty",
        "operating_condition"
      ],
      "properties": {
        "mapping_action": {
          "enum": ["accept_suggested_target", "remap_target"]
        },
        "target": {
          "$ref": "#/$defs/target"
        },
        "observation": {
          "oneOf": [
            {"$ref": "#/$defs/scalarObservation"},
            {"$ref": "#/$defs/rangeObservation"}
          ]
        },
        "source_interpretation": {
          "$ref": "#/$defs/sourceInterpretation"
        },
        "evidence_class": {
          "enum": ["official_stated", "source_derived", "digitized_curve"]
        },
        "extraction_method": {
          "enum": [
            "manual_transcription",
            "machine_text_assisted",
            "curve_digitization",
            "equation_derivation"
          ]
        },
        "uncertainty": {
          "$ref": "#/$defs/uncertainty"
        },
        "operating_condition": {
          "$ref": "#/$defs/operatingCondition"
        }
      }
    },
    "proposal": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "requested_disposition",
        "fact",
        "blocker_resolutions",
        "rationale"
      ],
      "properties": {
        "requested_disposition": {
          "enum": ["accept_source_fact", "reject_candidate", "defer_candidate"]
        },
        "fact": {
          "oneOf": [
            {"$ref": "#/$defs/factProposal"},
            {"type": "null"}
          ]
        },
        "blocker_resolutions": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["blocker", "resolution", "evidence_refs"],
            "properties": {
              "blocker": {
                "$ref": "#/$defs/text"
              },
              "resolution": {
                "$ref": "#/$defs/text"
              },
              "evidence_refs": {
                "$ref": "#/$defs/refs"
              }
            }
          }
        },
        "rationale": {
          "$ref": "#/$defs/text"
        }
      }
    },
    "integrity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["record_sha256"],
      "properties": {
        "record_sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    }
  }
}
