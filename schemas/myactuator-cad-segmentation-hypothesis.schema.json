{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hyperspawn.dev/schemas/myactuator-cad-segmentation-hypothesis.schema.json",
  "title": "Non-authoritative MYACTUATOR CAD segmentation hypothesis",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "variant_id",
    "step_sha256",
    "evidence_class",
    "housing_occurrences",
    "output_occurrences",
    "source_axis_unit",
    "origin_source_mm",
    "source_to_canonical",
    "evidence_refs",
    "rationale",
    "unresolved_questions",
    "semantic_review_complete",
    "support_granted"
  ],
  "properties": {
    "schema_version": {"const": "myactuator-cad-segmentation-hypothesis/1"},
    "variant_id": {"type": "string", "pattern": "^step-[0-9a-f]{20}$"},
    "step_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "evidence_class": {"const": "automated-and-visual-candidate-not-reviewed"},
    "housing_occurrences": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^NAUO[0-9]+$"}
    },
    "output_occurrences": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^NAUO[0-9]+$"}
    },
    "source_axis_unit": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {"type": "number"}
    },
    "origin_source_mm": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {"type": "number"}
    },
    "source_to_canonical": {
      "type": "array",
      "minItems": 16,
      "maxItems": 16,
      "items": {"type": "number"}
    },
    "evidence_refs": {
      "type": "array",
      "minItems": 2,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "rationale": {"type": "string", "minLength": 1},
    "unresolved_questions": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "semantic_review_complete": {"const": false},
    "support_granted": {"const": false}
  }
}
