{
  "authority": "static_claim_surface_scope_only",
  "binary_suffixes": [
    ".glb",
    ".png",
    ".step"
  ],
  "excluded_directory_names": [
    ".mypy_cache",
    ".pio",
    ".pytest_cache",
    "__pycache__",
    "node_modules"
  ],
  "excluded_paths": [
    {
      "path": "generated/myactuator/claim_surface",
      "reason": "The generated report cannot scan or hash itself."
    },
    {
      "path": "generated/verification/offline_gate_report.json",
      "reason": "The live gate report changes while the gate runs and is independently schema and artifact checked."
    },
    {
      "path": "tools/audit_claim_surfaces.py",
      "reason": "The scanner necessarily contains the forbidden lexical patterns it executes."
    },
    {
      "path": "tools/claim-surface-policy.json",
      "reason": "The scope policy is independently hash-bound as verifier input."
    }
  ],
  "roots": [
