#!/bin/sh
# Keep Wi-Fi management traffic on Wi-Fi when Ethernet shares the same LAN.
# NetworkManager invokes this as: script INTERFACE ACTION

INTERFACE_NAME="${1:-}"
ACTION="${2:-}"
ROUTE_TABLE="138"
RULE_PRIORITY="1138"

[ "$INTERFACE_NAME" = "wlan0" ] || exit 0

clear_policy() {
    while ip -4 rule delete priority "$RULE_PRIORITY" 2>/dev/null; do :; done
    ip -4 route flush table "$ROUTE_TABLE" 2>/dev/null || true
}

install_policy() {
    WIFI_ADDRESS="$(ip -4 -o address show dev "$INTERFACE_NAME" scope global | awk 'NR == 1 { split($4, address, "/"); print address[1] }')"
    WIFI_SUBNET="$(ip -4 route show dev "$INTERFACE_NAME" proto kernel scope link | awk 'NR == 1 { print $1 }')"
    WIFI_GATEWAY="$(ip -4 route show default dev "$INTERFACE_NAME" | awk 'NR == 1 { print $3 }')"

    [ -n "$WIFI_ADDRESS" ] || return 0
    [ -n "$WIFI_SUBNET" ] || return 0

    clear_policy
    ip -4 route replace "$WIFI_SUBNET" dev "$INTERFACE_NAME" src "$WIFI_ADDRESS" table "$ROUTE_TABLE"
    if [ -n "$WIFI_GATEWAY" ]; then
        ip -4 route replace default via "$WIFI_GATEWAY" dev "$INTERFACE_NAME" table "$ROUTE_TABLE"
    fi
    ip -4 rule add priority "$RULE_PRIORITY" from "$WIFI_ADDRESS/32" lookup "$ROUTE_TABLE"
}

case "$ACTION" in
    up|dhcp4-change|connectivity-change)
        install_policy
        ;;
    pre-down|down)
        clear_policy
        ;;
esac

exit 0
